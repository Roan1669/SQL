
------ Query to get Sequences from database

SELECT 
    'CREATE SEQUENCE [' + s.name + '].[' + seq.name + ']' + 
    ' AS ' + t.name +
    ' START WITH ' + CAST(seq.start_value AS VARCHAR) + 
    ' INCREMENT BY ' + CAST(seq.increment AS VARCHAR) +
    CASE 
        WHEN seq.minimum_value IS NOT NULL THEN ' MINVALUE ' + CAST(seq.minimum_value AS VARCHAR) ELSE '' 
    END +
    CASE 
        WHEN seq.maximum_value IS NOT NULL THEN ' MAXVALUE ' + CAST(seq.maximum_value AS VARCHAR) ELSE '' 
    END +
    CASE 
        WHEN seq.is_cycling = 1 THEN ' CYCLE' ELSE ' NO CYCLE' 
    END +
    ';' AS CreateSequenceScript
FROM sys.sequences seq
JOIN sys.schemas s ON seq.schema_id = s.schema_id
JOIN sys.types t ON seq.user_type_id = t.user_type_id;